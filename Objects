//An Object is a variable that can hold many variables.
//Objects are collections of key-value pairs, where each key (known as property names) has a value.
//Objects can describe anything like houses, cars, people, animals, or any other subjects.
//You should declare objects with the const keyword.

//Object literal 
//An object literal is a concise way to create an object.
//An object literal is a list of key : value pairs inside curly braces { }:

//Syntax
// const objectName = {key1:"Value1", Key2:"Value2", Key3:"Value3"}

//Different ways to create an objects 
//1 - In a single line
const car = { carName: "BMW", model: "G50", color: "Red" }
let car1 = car.carName + " " + car.model + " " + car.color
console.log(car1)

//2 - line by line
const person = {
    fName: "Deepak", //property 1 as Key:Value
    lName: "Sharma", //property 2 as Key:value
    age: 50
};

let person1 = person.fName + " " + person.lName
console.log(person1)

//3 - Create an object and add its properties later on
const animal = {};
animal.name = "Elephant"
animal.color = "Grey"
animal.species = "Animal"
console.log(animal.name + " " + animal.color + " " + animal.species)



//4 - Using new object()
const city = new Object({
    name: "Mumbai",
    state: "Maharashtra",
    gdpRank: "Numer 1"
})
console.log(city.name + " " + city["state"] + " " + city.gdpRank)

//There is no need to use new Object().
//For readability, simplicity and speed, use an object literal instead.


// Object Properties
//You can access object properties in two ways:
console.log(city.name)
console.log(city["name"])



//JavaScript Object Methods
//Object methods are actions that can be performed on objects.
//Object methods are function definitions stored as property values:

let company = {
    companyName: "TCS",
    companyLocation: "Mumbai",
    companySince: 1900,
    companyFullInfo: function () {
        return this.companyName + " " + this.companyLocation;

        //In the example above, this refers to the person object:
        //this.companyName means the firstName property of person.
        //this.companyLocation means the lastName property of person
    }
};

console.log(company.companyFullInfo())


//Object Constructor Functions
//Sometimes we need to create many objects of the same type.
//To create an object type we use an object constructor function.
//It is considered good practice to name constructor functions with an upper-case first letter.

function Branch(unitNo, khetraNo, zone) {
    this.unitNo = unitNo;
    this.khetraNo = khetraNo;
    this.zone = zone;
}

const powai = new Branch("1382", "01", "13")
const chandivali = new Branch(1838, "01", "13")

console.log("The Branch is " + powai.unitNo)
console.log("The branch is " + chandivali.unitNo)


