//JS Hoisting 

//Var hositing - Declaration after print
h1 = "Hoisting"; //Assignement
console.log(h1)
var h1 //Declaration



// let hoisting
// The variable will be hoisted but its value will NOT be initialized, so it goes into the Temporal Dead Zone (TDZ)

// Example
// h3 = "Hoisting 3"        // Assignment before declaration
// console.log(h3)          // ❌ ReferenceError: Cannot access 'h3' before initialization
// let h3                   // Declaration (enters TDZ until this line executes)

// Brief explanation
// 1. let h3 -> Hoisting happens, but the variable is in TDZ
//    - TDZ = variable exists in memory but is "locked"
//    - Cannot read or write before declaration line
// 2. Any access (read/write) before declaration throws ReferenceError
// 3. Once 'let h3' is executed, TDZ ends and variable can be assigned and accessed
// 4. Now, h3 = "Hoisting 3" is valid
// 5. console.log(h3) will print "Hoisting 3"

// Correct usage
let h3;            // Declaration (TDZ ends here)
h3 = "Hoisting 3"; // Assignment
console.log(h3);   // Output: "Hoisting 3"


